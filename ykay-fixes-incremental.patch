+-- CreateTable
+CREATE TABLE "SystemFlags" (
+    "id" TEXT NOT NULL,
+    "maintenanceMode" BOOLEAN NOT NULL DEFAULT false,
+    "maintenanceMessage" TEXT NOT NULL DEFAULT 'Ykay EduPortal is undergoing scheduled maintenance. Please try again shortly.',
+    "updatedAt" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updatedByUserId" TEXT,
+
+    CONSTRAINT "SystemFlags_pkey" PRIMARY KEY ("id")
+);
diff --git a/prisma/schema.prisma b/prisma/schema.prisma
index 198cf59..939617c 100644
--- a/prisma/schema.prisma
+++ b/prisma/schema.prisma
@@ -1168,3 +1168,13 @@ model SecurityEvent {
   @@index([userEmail, createdAt])
   @@index([createdAt])
 }
+
+/// Platform-wide flags (singleton row, id = "singleton"). Persisted in the DB so
+/// maintenance mode works on serverless (read-only filesystem) deployments.
+model SystemFlags {
+  id                 String   @id @default("singleton")
+  maintenanceMode    Boolean  @default(false)
+  maintenanceMessage String   @default("Ykay EduPortal is undergoing scheduled maintenance. Please try again shortly.")
+  updatedAt          DateTime @updatedAt
+  updatedByUserId    String?
+}
