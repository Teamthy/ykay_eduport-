{
  "expo": {
    "name": "Ykay College",
    "slug": "ykay-college",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ykaycollege",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ykaycollege.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00072D"
      },
      "package": "com.ykaycollege.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "f38053b7-646c-4e7a-ae26-df18e92c3cb9"
      }
    }
  }
}
