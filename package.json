    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "tsx scripts/e2e-smoke.ts",
    "cleanup:artifacts": "tsx scripts/cleanup-artifacts.ts",
    "audit:routes": "tsx scripts/e2e-smoke.ts --list-only"
