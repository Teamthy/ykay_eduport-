+
+// ── EDUos multi-tenancy ────────────────────────────────────────────
+enum SchoolStatus {
+  ACTIVE
+  SUSPENDED
+}
+
+enum PlanTier {
+  FREE
+  BASIC
+  PREMIUM
+  ENTERPRISE
+}
+
+enum SubscriptionStatus {
+  TRIALING
+  ACTIVE
+  PAST_DUE
+  CANCELED
+}
+
+/// A sellable plan tier. `studentLimit` null = unlimited.
+model Plan {
+  id           String   @id @default(cuid())
+  tier         PlanTier @unique
+  name         String
+  priceKobo    Int      @default(0)
+  studentLimit Int?
+  features     Json?
+  isActive     Boolean  @default(true)
+  createdAt    DateTime @default(now())
+  updatedAt    DateTime @updatedAt
+
+  subscriptions Subscription[]
+}
+
+/// A school's subscription to a plan. One per school.
+model Subscription {
+  id                       String             @id @default(cuid())
+  schoolId                 String             @unique
+  planId                   String
+  status                   SubscriptionStatus @default(TRIALING)
+  currentPeriodEnd         DateTime?
+  paystackSubscriptionCode String?
+  createdAt                DateTime           @default(now())
+  updatedAt                DateTime           @updatedAt
+
+  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
+  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)
+}
+
+/// Per-tenant branding (logo, palette, fonts, hero image). One row per school.
+model TenantBranding {
+  schoolId       String   @id
+  logoUrl        String?
+  faviconUrl     String?
+  primaryColor   String?
+  secondaryColor String?
+  accentColor    String?
+  fontDisplay    String?
+  fontBody       String?
+  heroImageUrl   String?
+  displayName    String?
+  tagline        String?
+  updatedAt      DateTime @updatedAt
+
+  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
+}
