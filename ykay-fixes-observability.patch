-            reviewedAt: new Date(),
-            reviewedByUserId: context.user.id,
-          },
-        });
-      }
-
-      return session;
-    });
-
-    return jsonNoStore({
-      ok: true,
-      session: {
-        id: savedSession.id,
-        date: attendanceDateKey(savedSession.sessionDate),
-        periodKey: savedSession.periodKey,
-        isLocked: savedSession.isLocked,
-        submittedAt: savedSession.submittedAt?.toISOString() || null,
-      },
-      summary,
-      notificationPreview: {
