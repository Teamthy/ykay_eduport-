@@ -0,0 +1,23 @@
+import * as Sentry from "@sentry/nextjs";
+
+/**
+ * Server (Node.js runtime) Sentry initialisation.
+ * Activated only when NEXT_PUBLIC_SENTRY_DSN is set; otherwise a no-op.
+ * Loaded via instrumentation.ts on server start.
+ */
+const SENTRY_DSN = process.env.NEXT_PUBLIC_SENTRY_DSN;
+
+if (SENTRY_DSN) {
+  Sentry.init({
+    dsn: SENTRY_DSN,
+    environment: process.env.NODE_ENV,
+    tracesSampleRate: process.env.NODE_ENV === "production" ? 0.1 : 1.0,
+    ignoreErrors: [
+      "ResizeObserver loop limit exceeded",
+      "Non-Error promise rejection captured",
+      "Loading chunk",
+      "NetworkError",
+      "Failed to fetch",
+    ],
+  });
+}
